DB_HOST=localhost
DB_PORT=5432
DB_NAME=amancay
DB_USER=postgres
DB_PASSWORD=postgres

# Project URL de Supabase (Project Settings > Data API). Obligatoria: se usa para validar los JWT.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Origenes permitidos para CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bypass de autenticacion para desarrollo local: toda request corre como un usuario fijo
# sin necesidad de token. Nunca habilitar fuera de desarrollo.
AMANCAY_SECURITY_DEV_USER_ENABLED=false

# Clave compartida que debe mandar el servicio de cola (bigqueue) en el header
# X-Internal-Api-Key al entregar mensajes a /internal/events/**. Vacia por defecto: sin
# configurarla, ese endpoint rechaza todo (fail closed). Es un placeholder hasta definir
# con ese servicio un mecanismo mas robusto.
EVENTS_WEBHOOK_API_KEY=
