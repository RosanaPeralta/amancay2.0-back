DB_HOST=localhost
DB_PORT=5432
DB_NAME=amancay
DB_USER=postgres
DB_PASSWORD=postgres

# Project URL de Supabase (Project Settings > Data API). Obligatoria: se usa para validar los JWT.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Origenes permitidos para CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Bypass de autenticacion para desarrollo local: toda request corre como un usuario fijo
# sin necesidad de token. Nunca habilitar fuera de desarrollo.
AMANCAY_SECURITY_DEV_USER_ENABLED=false

# Clave compartida que debe mandar el servicio de cola (bigqueue) en el header
# X-Internal-Api-Key al entregar mensajes a /internal/events/**. Vacia por defecto: sin
# configurarla, ese endpoint rechaza todo (fail closed). Es un placeholder hasta definir
# con ese servicio un mecanismo mas robusto.
EVENTS_WEBHOOK_API_KEY=
# Cotizacion de envios: coordenadas del deposito y tarifa (costo = base + km * costo por km).
SHIPPING_ORIGIN_LAT=-34.6170
SHIPPING_ORIGIN_LON=-58.3817
SHIPPING_BASE_COST=5.00
SHIPPING_COST_PER_KM=0.50
# Paises donde se busca la direccion (codigos ISO separados por coma).
SHIPPING_COUNTRY_CODES=ar

AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

MP_ACCESS_TOKEN=
MP_FRONTEND_URL=http://localhost:5173

# RabbitMQ: el estado del pedido avanza por cola desde EN_PREPARACION (ver MENSAJERIA.md).
# Localmente se levanta con "docker compose up -d" en la raiz de DDA2.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# Mails: false = solo se loguean. true = se mandan por SMTP (Mailpit en desarrollo: http://localhost:8025).
MAIL_ENABLED=false
MAIL_FROM=Amancay <no-reply@amancay.local>
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
